<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_my_approvals_digest" model="mail.template">
        <field name="name">Mis aprobaciones: resumen diario</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="subject">Tenés aprobaciones pendientes</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.email_formatted }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="lang">{{ object.lang }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p>Hola <t t-out="object.name or ''">Usuario</t>,</p>
                <p>Esto es lo que te toca aprobar:</p>
                <t t-foreach="object._my_approvals_digest_groups()" t-as="group">
                    <h3 style="margin-bottom: 4px;" t-out="group['name']">Tipo de documento</h3>
                    <table style="border-collapse: collapse; width: 100%; margin-bottom: 24px;">
                        <tr style="background-color: #f1f1f1;">
                            <th style="padding: 6px; text-align: left;">Documento</th>
                            <th style="padding: 6px; text-align: left;">Pedida por</th>
                            <th style="padding: 6px; text-align: left;">Espera</th>
                        </tr>
                        <tr t-foreach="group['rows']" t-as="row"
                            style="border-bottom: 1px solid #e6e6e6;">
                            <td style="padding: 6px;">
                                <a t-att-href="row['url']" t-out="row['name']">Documento</a>
                            </td>
                            <td style="padding: 6px;" t-out="row['requested_by']">Usuario</td>
                            <td style="padding: 6px;">
                                <t t-if="row['days'] == 0">Hoy</t>
                                <t t-elif="row['days'] == 1">1 día</t>
                                <t t-else=""><t t-out="row['days']">2</t> días</t>
                            </td>
                        </tr>
                    </table>
                </t>
                <p>
                    <a t-att-href="object._my_approvals_inbox_url()"
                       style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
                        Ver Mis aprobaciones
                    </a>
                </p>
            </div>
        </field>
    </record>
</odoo>
