<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Corre cada hora: el envío en sí lo deciden la hora configurada en cada
         compañía y la fecha del último resumen. -->
    <record id="ir_cron_my_approvals_digest" model="ir.cron">
        <field name="name">Mis aprobaciones: resumen diario</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model._cron_my_approvals_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
